# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=8012
LAN_IP=192.168.1.10
TZ=Europe/London
APP_URL=http://192.168.1.10:8012     # also in the links your clients get
SSL_PROXY=0
IN_IMAGE=invoiceninja/invoiceninja-debian:5
WEB_IMAGE=nginx:stable-alpine
DB_IMAGE=mariadb:11.4
DB_PASSWORD=…                        # made at install
DB_ROOT_PASSWORD=…
APP_KEY=base64:…                     # protects stored secrets; kept in every backup
ADMIN_EMAIL=you@example.com          # your account (the password is never stored; it's shown once)
ADMIN_NAME=Your+Name
IN_USER_EMAIL=                       # set only for the very first start, with a throwaway IN_PASSWORD the package replaces
IN_PASSWORD=
REQUIRE_HTTPS=false                  # true when the address is https
MAIL_MAILER=log                      # smtp once a mail server is set in the window
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM=invoices@example.com
MAIL_FROM_NAME="Your business"
DSM_ALERTS=1                         # a DSM notification when an invoice goes overdue
TLS=off                              # dsm | self | off — HTTPS served by nginx in front
TLS_SOURCE=off
